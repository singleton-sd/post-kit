{
  "root": {
    "type": "EmailLayout",
    "data": {
      "backdropColor": "#F8F8F8",
      "canvasColor": "#FFFFFF",
      "textColor": "#242424",
      "fontFamily": "MODERN_SANS",
      "childrenIds": ["block-text"]
    }
  },
  "block-text": {
    "type": "Text",
    "data": {
      "style": {
        "fontWeight": "normal",
        "padding": { "top": 16, "bottom": 16, "right": 24, "left": 24 }
      },
      "props": {
        "text": "Hello {{name}}, from {{email}}: {{message}}"
      }
    }
  }
}
