{
  "root": {
    "type": "EmailLayout",
    "data": {
      "backdropColor": "#F8F8F8",
      "canvasColor": "#FFFFFF",
      "textColor": "#242424",
      "fontFamily": "MODERN_SANS",
      "childrenIds": ["block-heading", "block-from", "block-message"]
    }
  },
  "block-heading": {
    "type": "Text",
    "data": {
      "style": {
        "fontWeight": "bold",
        "padding": { "top": 24, "bottom": 8, "right": 24, "left": 24 }
      },
      "props": {
        "text": "New contact request"
      }
    }
  },
  "block-from": {
    "type": "Text",
    "data": {
      "style": {
        "fontWeight": "normal",
        "padding": { "top": 0, "bottom": 8, "right": 24, "left": 24 }
      },
      "props": {
        "text": "From {{name}} ({{email}})"
      }
    }
  },
  "block-message": {
    "type": "Text",
    "data": {
      "style": {
        "fontWeight": "normal",
        "padding": { "top": 0, "bottom": 24, "right": 24, "left": 24 }
      },
      "props": {
        "text": "{{message}}"
      }
    }
  }
}
