# Local / Function App env for post-kit
# Copy to `.env` and fill values. Never commit `.env` or real secrets.

# Azure context (IDs and names only — provision later; see SETUP.md)
# Subscription: 01c0bb8b-3770-4765-979a-cb13ae7e3dd2 (Singleton SD)
# Resource group: rg-ssd-global
# Key Vault: ssd-global-kv-prod-ae
# Function App: ssd-postkit-api-prod-ae
# Plan: ssd-postkit-plan-prod-ae (Y1 Consumption)
# Storage: ssdpostkitstprodae
AZURE_SUBSCRIPTION_ID=01c0bb8b-3770-4765-979a-cb13ae7e3dd2
AZURE_RESOURCE_GROUP=rg-ssd-global
AZURE_LOCATION=australiaeast
AZURE_KEY_VAULT_NAME=ssd-global-kv-prod-ae
AZURE_FUNCTION_APP_NAME=ssd-postkit-api-prod-ae

# Pipelines: OIDC → Azure → Key Vault. Do not use GitHub Secrets for tokens.
# GitHub Variables (IDs only): AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID

# Email (Forward Email). Runtime token: FORWARD_EMAIL_TOKEN (never commit).
# KV secret name (planned): forwardemail-api-key
FORWARD_EMAIL_TOKEN=
FORWARD_EMAIL_BASE_URL=https://api.forwardemail.net
EMAIL_PROVIDER=development
EMAIL_ALLOW_PRODUCTION_SEND=
EMAIL_FROM_ADDRESS=noreply@mail.example.com
EMAIL_FROM_NAME=PostKit
CONTACT_INBOX_ADDRESS=
# Optional per-host contact profiles (JSON object).
# CONTACT_EMAIL_PROFILES_BY_HOST={"example.com":{"fromAddress":"noreply@mail.example.com","fromName":"Example","contactInboxAddress":"hello@example.com"}}

# Allowed origins for the Functions API (comma-separated). Empty = unset.
ORIGINS=
